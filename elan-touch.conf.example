# /etc/elan-touch.conf - every key is optional; these are the defaults.

[matcher]
# Decision threshold, in standard deviations of what unrelated fingers produce.
# On the development unit the worst impostor against a clean template reached 4.64.
# Lower = more convenient and less safe. Do not go below 5.5.
accept_z = 6.0

[service]
# Distinct finger placements tried per authentication before "no match" is reported.
# A finger that stays put is not counted again; one that shifts a little is a new attempt.
touches_per_verify = 3
# After this many failed prompts in a row the fingerprint is paused (the password still works).
# The pause doubles each time, up to 15 minutes, and resets on a successful match.
lockout_after = 3
lockout_seconds = 60
