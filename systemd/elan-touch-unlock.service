[Unit]
Description=elan-touch: unlock the session by touching the fingerprint sensor
# Ordering only, never a requirement: some desktops (Plasma 5.24 on Ubuntu 22.04,
# for one) never activate graphical-session.target, and a unit wanted only by that
# target silently never runs. default.target is always reached by systemd --user.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Environment=PYTHONPATH=/usr/local/lib/elan-touch
ExecStart=/usr/bin/python3 -m elantouch.unlock
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
